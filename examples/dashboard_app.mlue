  "rules": [
    {
      "trigger": "threshold_exceeded",
      "condition": {
        "entity": "slider_knob",
        "property": "position.x",
        "op": ">=",
        "value": 0.78
      },
      "actions": [
        {
          "type": "set_property",
          "target": "status_indicator_led",
          "property": "color",
          "value": "#EF4444"
        },
        {
          "type": "set_property",
          "target": "meter_fill_bar",
          "property": "color",
          "value": "#EF4444"
        },
        {
          "type": "set",
          "target": "alarm_state",
          "value": 1
        }
      ]
    },
    {
      "trigger": "threshold_normal",
      "condition": {
        "entity": "slider_knob",
        "property": "position.x",
        "op": "<=",
        "value": 0.6
      },
      "actions": [
        {
          "type": "set_property",
          "target": "status_indicator_led",
          "property": "color",
          "value": "#10B981"
        },
        {
          "type": "set_property",
          "target": "meter_fill_bar",
          "property": "color",
          "value": "#10B981"
        },
        {
          "type": "set",
          "target": "alarm_state",
          "value": 0
        }
      ]
    }
  ]
}