    {
      "trigger": "floor_breach",
      "condition": {
        "entity": "ball_01",
        "property": "position.y",
        "op": ">=",
        "value": 0.98
      },
      "actions": [
        { "type": "increment", "target": "lives", "amount": -1 },
        {
          "type": "reset_entity",
          "target": "ball_01",
          "position": { "x": 0.5, "y": 0.7 },
          "velocity": { "vx": 0.35, "vy": -0.45 }
        }
      ]
    },
    {
      "trigger": "check_victory",
      "condition": {
        "state_variable": "bricks_remaining",
        "op": "<=",
        "value": 0
      },
      "actions": [
        { "type": "set", "target": "game_state", "value": "VICTORY" }
      ]
    }
